{
    "require": {
        "dompdf/dompdf": "^1.0",
        "phpmailer/phpmailer": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Dompdf\\": "vendor/dompdf/dompdf/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sesystem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:all": "@php scripts/run-phpunit-with-http.php"
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
